# ── User Profile ──────────────────────────────────────────────────────────────
USER_NAME=Your Full Name
USER_EMAIL=your@email.com
USER_PHONE=+91-9999999999
RESUME_PATH=resume.pdf

# ── Job Preferences ───────────────────────────────────────────────────────────
# Comma-separated list of keywords; the first keyword is used for auto-searches
JOB_KEYWORDS=Python Developer,Backend Engineer,Software Engineer
JOB_LOCATION=India
EXPERIENCE_YEARS=2

# ── Naukri.com Login (required only for auto-apply) ───────────────────────────
NAUKRI_EMAIL=your_naukri@email.com
NAUKRI_PASSWORD=your_naukri_password

# ── Adzuna API (optional — free tier, 250 requests/month) ────────────────────
# Sign up at https://developer.adzuna.com for a FREE API key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ── Scraper Behaviour ─────────────────────────────────────────────────────────
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
MAX_JOBS_PER_SOURCE=50

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=jobs.db

# ── Web Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False
